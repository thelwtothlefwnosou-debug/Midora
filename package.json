{
  "name": "midora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/generate-build-info.ts",
    "dev:open": "powershell -ExecutionPolicy Bypass -File scripts/dev-open.ps1",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/dev-safe-restart.ps1",
    "dev:restart:clean": "powershell -ExecutionPolicy Bypass -File scripts/dev-safe-restart.ps1 -CleanCache",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-next.ps1",
    "qa:doctor": "node scripts/qa-doctor.mjs",
    "qa:preflight": "powershell -ExecutionPolicy Bypass -File scripts/qa-preflight.ps1",
    "qa:preflight:clean": "powershell -ExecutionPolicy Bypass -File scripts/qa-preflight.ps1 -Clean",
    "qa:smoke": "playwright test tests/smoke/midora-smoke.spec.ts tests/smoke/assistant-help.spec.ts tests/smoke/search-date-picker.spec.ts",
    "qa:smoke:install": "playwright install chromium",
    "qa:all": "npm run qa:doctor && npm run qa:preflight && npm run qa:smoke",
    "checkpoint": "powershell -ExecutionPolicy Bypass -File scripts/checkpoint.ps1",
    "checkpoint:list": "powershell -ExecutionPolicy Bypass -File scripts/checkpoint.ps1 -List",
    "checkpoint:restore": "powershell -ExecutionPolicy Bypass -File scripts/checkpoint.ps1",
    "checkpoint:prune": "powershell -ExecutionPolicy Bypass -File scripts/checkpoint-prune.ps1",
    "checkpoint:prune:dry": "powershell -ExecutionPolicy Bypass -File scripts/checkpoint-prune.ps1 -DryRun",
    "git:hooks": "powershell -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1",
    "git:push": "powershell -ExecutionPolicy Bypass -File scripts/push-safe.ps1",
    "git:remote": "powershell -ExecutionPolicy Bypass -File scripts/setup-git-remote.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/run-check.ps1",
    "check:full": "powershell -ExecutionPolicy Bypass -File scripts/run-check.ps1 -Full",
    "verify:ui": "powershell -ExecutionPolicy Bypass -File scripts/verify-canonical-ui.ps1",
    "git:init": "powershell -ExecutionPolicy Bypass -File scripts/init-git-checkpoint.ps1",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "lint:gate": "eslint tests/smoke playwright.config.ts scripts/check-old-ui-regression.mjs scripts/qa-doctor.mjs",
    "db:check": "tsx scripts/check-supabase.ts",
    "db:check-connection": "tsx scripts/check-db-connection.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "db:migrate-favorites": "tsx scripts/migrate-favorites.ts",
    "db:migrate-listing-images": "tsx scripts/migrate-listing-images.ts",
    "db:migrate-portal": "tsx scripts/migrate-portal-schema.ts",
    "db:migrate-unavailable": "tsx scripts/migrate-unavailable-periods.ts",
    "db:migrate-short-term-pricing": "tsx scripts/migrate-short-term-pricing.ts",
    "db:apply-pending-migrations": "tsx scripts/apply-pending-migrations.ts",
    "db:publish-owner-listings": "tsx scripts/publish-owner-listings.ts",
    "db:check-short-term-pricing": "tsx scripts/check-short-term-pricing-migration.ts",
    "db:migrate-listing-views": "tsx scripts/migrate-listing-views.ts",
    "db:seed-admin-review": "tsx scripts/seed-admin-review-listings.ts",
    "db:refresh-admin-review": "tsx scripts/seed-admin-review-listings.ts -- --refresh",
    "db:seed-greece-300": "tsx scripts/seed-greece-300.ts",
    "db:seed-owner-showcase": "tsx scripts/seed-owner-short-term-demo.ts",
    "db:seed-cohost-demo": "tsx scripts/seed-cohost-demo.ts",
    "db:setup-admin": "tsx scripts/setup-admin-demo.ts",
    "test:listing-photo-persist": "tsx scripts/test-listing-photo-persist.ts",
    "build:locations": "tsx scripts/build-greece-locations.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.18.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "stripe": "^22.2.1",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.184.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vercel": "^54.18.2",
    "@playwright/test": "^1.52.0"
  }
}
