{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/mark-checkpoint-pending.ps1"
      }
    ],
    "stop": [
      {
        "command": "powershell -ExecutionPolicy Bypass -File .cursor/hooks/auto-checkpoint-on-stop.ps1",
        "timeout": 120
      }
    ]
  }
}
